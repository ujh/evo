#!/usr/bin/env ruby
require "bundler/setup"
require_relative "ruby/all"

# Creates experiments/NAME with its settings, without the prompts.
name, *arguments = ARGV
if name.nil? || name.include?("=")
  warn "Usage: mise run new-experiment NAME key=value ..."
  warn "Settings: #{SetupExperiment::SETTINGS.keys.join(', ')}"
  exit 1
end

begin
  settings = SetupExperiment.create("experiments/#{name}", arguments)
  puts "Created experiments/#{name} with seed #{settings['seed']}"
rescue ArgumentError => e
  warn e.message
  exit 1
end
