#!/usr/bin/env ruby
# Shows an experiment's tournament, population, and benchmark figures (see
# ExperimentStats). Reads the experiment database read-only, so it can run
# while the runner writes.
require 'bundler/setup'
require 'optparse'
require_relative 'ruby/experiment_database'
require_relative 'ruby/experiment_stats'
require_relative 'ruby/stats_report'

options = {}
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: ./stats [--watch | --csv] experiment-name'
  opts.on('--watch', 'Redraw the tables every 5 seconds until Ctrl-C') { options[:watch] = true }
  opts.on('--csv', 'Print one CSV row per generation instead of tables') { options[:csv] = true }
end
parser.parse!

name = ARGV.first
if name.nil? || (options[:watch] && options[:csv])
  puts parser.help
  exit 1
end

path = File.join('experiments', name, 'experiment.sqlite3')
unless File.exist?(path)
  puts "No experiment #{name}: #{path} does not exist."
  exit 1
end

database = ExperimentDatabase.new(path, readonly: true)
stats = ExperimentStats.new(database)

if options[:watch]
  begin
    ExperimentStats::Report.watch(stats, $stdout)
  rescue Interrupt
    puts
  end
elsif options[:csv]
  puts ExperimentStats::Report.csv(ExperimentStats::Report.figures(stats))
else
  puts ExperimentStats::Report.text(ExperimentStats::Report.figures(stats))
end
database.close
