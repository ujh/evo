#!/usr/bin/env ruby
# Shows an experiment's tournament, population, genome, bot, and benchmark
# figures (see ExperimentStats); --watch shows only the bot tables and the
# ratings unless --extended. Reads the experiment database read-only, so it
# can run while the runner writes.
require 'bundler/setup'
require 'optparse'
require_relative 'ruby/experiment_database'
require_relative 'ruby/experiment_stats'
require_relative 'ruby/stats_report'

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ./stats [--watch [--extended] | --csv] experiment-name\n" \
                'Prints every table once, or with --watch redraws the bot tables and the ratings until Ctrl-C.'
  opts.on('--watch', "Redraw the latest 10 generations' bot tables and the ratings every 5 s") { options[:watch] = true }
  opts.on('--extended', 'With --watch, redraw every table instead, every 30 s') { options[:extended] = true }
  opts.on('--csv', 'Print one CSV row per generation instead of tables') { options[:csv] = true }
end
parser.parse!

name = ARGV.first
if name.nil? || (options[:watch] && options[:csv]) || (options[:extended] && !options[:watch])
  puts parser.help
  exit 1
end

path = File.join('experiments', name, 'experiment.sqlite3')
unless File.exist?(path)
  puts "No experiment #{name}: #{path} does not exist."
  exit 1
end

database = ExperimentDatabase.new(path, readonly: true)

begin
  stats = ExperimentStats.new(database)
  if options[:watch]
    begin
      ExperimentStats::Report.watch(stats, $stdout, extended: options[:extended])
    rescue Interrupt
      puts
    end
  elsif options[:csv]
    puts ExperimentStats::Report.csv(ExperimentStats::Report.figures(stats), stats.benchmark_opponents,
                                     bot_groups: stats.bot_groups)
  else
    puts ExperimentStats::Report.text(ExperimentStats::Report.figures(stats),
                                      ratings: ExperimentStats::Report.ratings(stats), dim: $stdout.tty?)
  end
rescue ExperimentStats::MissingSetting, ExperimentStats::Unmigrated => e
  # An experiment created before a setting the figures need, or not
  # migrated since a table they need.
  warn e.message
  exit 1
ensure
  database.close
end
