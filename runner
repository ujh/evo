#!/usr/bin/env ruby
require "bundler/setup"
require_relative "ruby/all"

experiment_name = ARGV[0]
concurrency = ARGV[1] || 2
one_generation = ARGV[2] == "one-generation"

if experiment_name.nil?
  puts "Name of experiment required as argument!"
  exit 1
end

exit(1) unless BuildDependencies.call

$stop_now = false

experiment_dir = "experiments/#{experiment_name}"

begin
  SetupExperiment.call(experiment_dir) do |settings, database|
    RunExperiment.call(settings.merge('concurrency' => concurrency, 'one_generation' => one_generation), database)
  end
rescue SetupExperiment::PromptAborted => e
  warn "\n#{e.message}. Nothing was saved; start again, or create the experiment with mise run new-experiment."
  exit 1
end
