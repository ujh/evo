#!/usr/bin/env ruby
require "bundler/setup"
require_relative "ruby/all"

# scripts/profile-workload.sh reads the runner's CPU time and GC totals from here.
ProcessProfile.install(ENV["EVO_PROFILE"]) unless ENV.fetch("EVO_PROFILE", "").empty?

begin
  options = RunnerOptions.parse(ARGV)
rescue RunnerOptions::Refused => e
  puts e.message
  exit 1
end

$stop_now = false

experiment_dir = "experiments/#{options.name}"

begin
  SetupExperiment.call(experiment_dir) do |settings, database|
    run_settings = settings.merge('concurrency' => options.concurrency, 'one_generation' => options.one_generation,
                                  'until_generation' => options.until_generation)
    RunExperiment.call(run_settings, database)
  end
rescue SetupExperiment::PromptAborted => e
  warn "\n#{e.message}. Nothing was saved; start again, or create the experiment with mise run new-experiment."
  exit 1
rescue SetupExperiment::Refused => e
  warn e.message
  exit 1
end
