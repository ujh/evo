+// evo's patch: seed used for --seed 0, which michi would otherwise take as
+// "seed from the clock"
+#define SEED_FOR_ZERO 2147483648u
+
+static unsigned int option_value(const char *option, const char *value,
+                                                        unsigned long min)
+{
+    char *end;
+    unsigned long v;
+    if (value == NULL || value[0] < '0' || value[0] > '9') {
+        fprintf(stderr, "michi: %s needs a non-negative integer\n", option);
+        exit(2);
+    }
+    v = strtoul(value, &end, 10);
+    if (*end != 0 || v < min || v > 4294967295ul) {
+        fprintf(stderr, "michi: invalid value for %s: %s\n", option, value);
+        exit(2);
+    }
+    return (unsigned int) v;
+}
+
+static const char* parse_options(int argc, char *argv[])
+// evo's patch: options after the mode, applied before the config file:
+//   --sims N          N_SIMS (playouts per move), N >= 1
+//   --seed N          random seed, 0 <= N < 2^32 (the same N, the same game)
+//   --play-until-end  play_until_the_end 1 (no early pass)
+// Returns the config file, or NULL.
+{
+    const char *config = NULL;
+    for (int k=2 ; k<argc ; k++) {
+        if (strcmp(argv[k], "--sims") == 0 && k+1 < argc)
+            N_SIMS = option_value("--sims", argv[++k], 1);
+        else if (strcmp(argv[k], "--seed") == 0 && k+1 < argc) {
+            unsigned int seed = option_value("--seed", argv[++k], 0);
+            idum = seed == 0 ? SEED_FOR_ZERO : seed;
+        }
+        else if (strcmp(argv[k], "--play-until-end") == 0)
+            play_until_the_end = 1;
+        else if (argv[k][0] != '-' && config == NULL)
+            config = argv[k];
+        else {
+            fprintf(stderr, "michi: unknown or incomplete option %s\n", argv[k]);
+            usage();
+        }
+    }
+    return config;
+}
