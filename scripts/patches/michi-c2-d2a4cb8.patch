+# Portable build (evo's patch): no -march=native or -msse4, so the same
+# flags work with clang and GCC on any architecture. -fcommon: several files
+# define the same globals (buf, mark1, mark2), which GCC 10 and later refuse
+# to link by default.
+CC = cc
+CFLAGS = -DNDEBUG -O3 -fcommon -fshort-enums -Wall -Wno-char-subscripts
 
